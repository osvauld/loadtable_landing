/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Each page carries its own policy in a <meta> tag (Layout.astro); the header adds what a meta tag can't.
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  # Chromium browsers fetch the next page on hover (speculation-rules.json); no script needed.
  Speculation-Rules: "/speculation-rules.json"

# The curl installer: shown as text in a browser, never cached past a release.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Built CSS and JS carry a content hash in their name: a changed file gets a new name,
# so the browser keeps these for a year and never asks again between pages.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts keep their names; a week is long enough to stop re-asking on every page.
/fonts/*
  Cache-Control: public, max-age=604800

/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600
